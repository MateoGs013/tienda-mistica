# Copiar a .env y completar con valores reales (NO commitear .env).
DB_NAME=tienda_mistica
DB_USER=tienda
DB_PASS=pon-una-contrasena-fuerte
DB_ROOT_PASS=pon-otra-contrasena-fuerte

# Admin inicial: se crea solo en el primer arranque si no existe.
ADMIN_EMAIL=admin@tienda.local
ADMIN_PASSWORD=pon-una-contrasena-fuerte

# Ruta base del sitio. En el VPS (dominio propio) va en la raíz.
APP_BASE_PATH=/

# Puerto local para probar con docker compose (no aplica en Coolify).
APP_PORT=8080
